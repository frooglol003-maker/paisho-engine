// src/parseNotation.ts
// Convert human notation into GameRecord objects ready for learn.ts

import { GameRecord, SetupRecord, Action } from "./parse";
import { Side } from "./engine";

function parseCoords(text: string): { x: number; y: number } {
  const m = text.match(/\((-?\d+),\s*(-?\d+)\)/);
  if (!m) throw new Error("Bad coords: " + text);
  return { x: parseInt(m[1], 10), y: parseInt(m[2], 10) };
}

function parseSide(ch: string): Side {
  if (ch === "H") return "host";
  if (ch === "G") return "guest";
  throw new Error("Bad side: " + ch);
}

function parseType(token: string): string {
  return token.trim().toUpperCase(); // "R3", "W5", "LOTUS", "O", "L", etc.
}

function parseSetupLine(line: string): SetupRecord {
  // Example: "0H.B,K,W,R"
  const m = line.match(/^0([HG])\.(.*)$/);
  if (!m) throw new Error("Bad setup line: " + line);
  const side = parseSide(m[1]);
  const types = m[2].split(",").map(s => s.trim());
  return { side, tiles: types };
}

function parseActionLine(line: string): Action {
  // Examples:
  // 1G.R3(0,-8)
  // 4H.(0,8)-(1,7)+R4(-8,0)
  // 8G.(0,-3)-(0,2)+K(-6,-1)
  // 9G.(8,0)-(7,1)+B(-6,0)-(-7,-1)

  const lm = line.match(/^(\d+)([HG])\.(.*)$/);
  if (!lm) throw new Error("Bad move line: " + line);

  const side = parseSide(lm[2]);
  let rest = lm[3];

  // --- Case 1: Planting a flower ---
  // R3(0,-8)
  const plantMatch = rest.match(/^([A-Za-z0-9]+)\((-?\d+),\s*(-?\d+)\)$/);
  if (plantMatch) {
    return {
      kind: "plant",
      side,
      tileType: parseType(plantMatch[1]),
      x: parseInt(plantMatch[2], 10),
      y: parseInt(plantMatch[3], 10),
    } as Action;
  }

  // --- Case 2: Arrange move (with optional +accent or +plant bonus) ---
  // (0,8)-(1,7)
  // (0,8)-(1,7)+R4(-8,0)
  // (8,0)-(7,1)+B(-6,0)-(-7,-1)

  const [mainPart, bonusPart] = rest.split("+");

  // Main arrange must have "(a,b)-(c,d)-...-..."
  const segments = mainPart.split("-").map(s => s.trim()).filter(Boolean);
  if (segments.length < 2) throw new Error("Bad arrange: " + line);

  const path = segments.map(seg => parseCoords(seg));

  const action: any = {
    kind: "arrange",
    side,
    path
  };

  // --- bonus handling ---
  if (bonusPart) {
    // Could be plant or accent
    // Plant bonus: R4(-8,0)
    // Accent bonus: B(-6,0)-(-7,-1)
    const plantBonus = bonusPart.match(/^([A-Za-z0-9]+)\((-?\d+),\s*(-?\d+)\)$/);
    if (plantBonus) {
      action.bonus = {
        kind: "plant",
        tileType: parseType(plantBonus[1]),
        x: parseInt(plantBonus[2], 10),
        y: parseInt(plantBonus[3], 10),
      };
      return action as Action;
    }

    // Accent bonus: e.g. B(-6,0)-(-7,-1)
    const pieces = bonusPart.split("-").map(s => s.trim());
    if (pieces.length >= 1) {
      const first = pieces[0];
      const tileType = parseType(first.replace(/\(.*$/, "")); // e.g. B
      const coordsPart = pieces.map(parseCoords);
      action.bonus = {
        kind: "accent",
        tileType,
        coords: coordsPart
      };
      return action as Action;
    }

    throw new Error("Bad bonus: " + bonusPart);
  }

  return action as Action;
}

export function parseNotationGame(id: string, text: string): GameRecord {
  const lines = text.split("\n").map(l => l.trim()).filter(Boolean);

  const setup: SetupRecord[] = [];
  const moves: Action[] = [];
  let result: "host" | "guest" | "draw" = "draw";

  for (const line of lines) {
    if (line.startsWith("0H.") || line.startsWith("0G.")) {
      setup.push(parseSetupLine(line));
      continue;
    }

    // Result line example: "RESULT host"
    if (/^RESULT/i.test(line)) {
      const r = line.split(/\s+/)[1];
      if (r === "host" || r === "guest" || r === "draw") result = r;
      continue;
    }

    // Otherwise it's a move line
    moves.push(parseActionLine(line));
  }

  return { id, setup, moves, result };
}
